#cloud-config
hostname: cfgm-vmtest
users:
  - name: vmtest
    sudo: ALL=(ALL) NOPASSWD:ALL
    shell: /bin/bash
    ssh_authorized_keys:
      - __SSH_PUBKEY__
packages:
  - network-manager
  - dnsmasq
  - bind9-dnsutils
  # The post-scripts applier runs `node apply-home-jq-transforms.mjs` off the share. In
  # production node arrives via 03-install-tools.sh (pnpm runtime); the tests
  # exercise 07 without running 01-03, so the golden image supplies it. The
  # bundle targets node18 and apt's nodejs is newer, so distro node is enough.
  - nodejs
write_files:
  # Mimic the Ubuntu Desktop installer: netplan renders through NetworkManager,
  # and the base profile carries only the renderer (no per-device config), so
  # 07's 60-dns-override.yaml is the sole definition of the interface (which is
  # exactly why that override must set dhcp4 itself — see 60-dns-override.yaml).
  - path: /etc/netplan/01-network-manager-all.yaml
    permissions: '0600'
    content: |
      network:
        version: 2
        renderer: NetworkManager
  # Stop cloud-init regenerating its systemd-networkd profile on later boots.
  - path: /etc/cloud/cloud.cfg.d/99-disable-network-config.cfg
    content: |
      network: {config: disabled}
runcmd:
  - rm -f /etc/netplan/50-cloud-init.yaml
  # The Ubuntu *cloud* image ships systemd-networkd enabled, and a match-all
  # /run/systemd/network/zzzz-dracut-default.network gives it ownership of the
  # NIC even though the netplan renderer is NetworkManager. networkd then
  # registers the DHCP-supplied DNS with systemd-resolved and holds the link, so
  # the 127.0.0.1 stub that 07's netplan override pushes through NetworkManager is
  # rejected LinkBusy and never becomes the resolver. A real Ubuntu Desktop runs
  # NetworkManager exclusively; masking networkd makes this golden image behave
  # the same. Plain `mask` (not `--now`) leaves the build boot's own networking
  # alone and only takes effect on the test overlays booted from this image.
  - systemctl mask systemd-networkd.service systemd-networkd.socket systemd-networkd-wait-online.service
  # dnsmasq is pre-installed so 07's `apt-get install -y dnsmasq` is an offline
  # no-op, but production has it absent-therefore-disabled before 07 runs.
  - systemctl disable --now dnsmasq || true
  - mkdir -p /mnt/vm-shared
  - printf 'vmshared /mnt/vm-shared 9p trans=virtio,ro,nofail,version=9p2000.L 0 0\n' >> /etc/fstab
